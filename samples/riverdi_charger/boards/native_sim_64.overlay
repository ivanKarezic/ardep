/ {
	chosen {
		zephyr,canbus = &can0;
		zephyr,display = &sdl_dc;
		zephyr,touch = &input_sdl_touch;
	};

	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		status = "okay";
		input = <&input_sdl_touch>;
		display = <&sdl_dc>;
	};
};

&sdl_dc {
	status = "okay";
	width = <1024>;
	height = <600>;
};

&can0 {
        status = "okay";
	/* Virtual CAN interface */
        host-interface = "vcan0";
	/* For real CAN interface (e.g. PCAN_USB), comment out the above line and uncomment the following */
	/* host-interface = "can0"; */
        sample-point = <875>;
        bitrate = <500000>;
};
