#include "stm32f769i_disco_flash_layout.dtsi"

/delete-node/ &{/soc/spi@a0001000/qspi-nor-flash@0/partitions/partition@0};

/ {
	chosen {
		zephyr,canbus = &can1;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		/* Not actually an LED, but used as a node from which to fetch gpio_dt_spec in application */
		lm_enable: led_4 {
			gpios = <&gpioj 1 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
			label = "LM_ENABLE";
		};
	};
};

&can1 {
	pinctrl-0 = <&can1_rx_pb8 &can1_tx_pb9>;
	pinctrl-names = "default";
	bitrate = <800000>;
	status = "okay";
};

&i2c1 {
	status = "disabled";
};
