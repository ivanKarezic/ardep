/dts-v1/;
#include <st/h7/stm32h7b3Xi.dtsi>
#include <st/h7/stm32h7b3lihxq-pinctrl.dtsi>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/memory-controller/stm32-fmc-sdram.h>

/ {
	model = "STMicroelectronics STM32H7B3I-EVAL with MB1370-LCD-B02";
	compatible = "st,stm32h7b3i-eval";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,display = &ltdc;
		zephyr,canbus = &fdcan1;
		zephyr,touch = &gt911;
	};

	/* Contiguous AXI SRAM1 and SRAM2 reserved for the LTDC framebuffer. */
	display_ram: memory@24040000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0x24040000 DT_SIZE_K(768)>;
		zephyr,memory-region = "DISPLAY_RAM";
	};

	can_phy: can-phy {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&mfx 9 GPIO_ACTIVE_HIGH>;
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};

	leds {
		compatible = "gpio-leds";

		/* Not actually an LED, but used as a node from which to fetch gpio_dt_spec in application */
		/* TODO: Change GPIO port and pin according to the actual hardware */
		lm_enable: led-1 {
			gpios = <&gpioh 3 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
			label = "LM_ENABLE";
		};
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&pll {
	div-m = <12>;
	mul-n = <280>;
	div-p = <2>;
	div-q = <7>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* 24 MHz / 12 * 400 / 24 = 33.333 MHz, per the ST LCD BSP. */
&pll3 {
	div-m = <12>;
	mul-n = <400>;
	div-p = <2>;
	div-q = <2>;
	div-r = <24>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(280)>;
	d1cpre = <1>;
	hpre = <1>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "smps-direct";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_ph4 &i2c2_sda_ph5>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	mfx: gpio@42 {
		compatible = "st,mfxstm32l152";
		reg = <0x42>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

	gt911: touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		alt-addr = <0x14>;
		irq-gpios = <&gpioh 2 GPIO_ACTIVE_HIGH>;
		screen-width = <800>;
		screen-height = <480>;
	};
};

&fdcan1 {
	/* CN22 uses PA11/PA12 when solder bridges SB35 and SB36 are fitted. */
	pinctrl-0 = <&fdcan1_rx_pa11 &fdcan1_tx_pa12>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>, <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	phys = <&can_phy>;
	bitrate = <500000>;
	status = "okay";
};

&fmc {
	pinctrl-0 = <&fmc_nbl0_pe0 &fmc_nbl1_pe1 &fmc_nbl2_pi4 &fmc_nbl3_pi5
		     &fmc_sdclk_pg8 &fmc_sdnwe_pa7 &fmc_sdcke1_ph7 &fmc_sdne1_ph6
		     &fmc_sdnras_pf11 &fmc_sdncas_pg15
		     &fmc_a0_pf0 &fmc_a1_pf1 &fmc_a2_pf2 &fmc_a3_pf3 &fmc_a4_pf4
		     &fmc_a5_pf5 &fmc_a6_pf12 &fmc_a7_pf13 &fmc_a8_pf14
		     &fmc_a9_pf15 &fmc_a10_pg0 &fmc_a11_pg1
		     &fmc_a14_pg4 &fmc_a15_pg5
		     &fmc_d0_pd14 &fmc_d1_pd15 &fmc_d2_pd0 &fmc_d3_pd1
		     &fmc_d4_pe7 &fmc_d5_pe8 &fmc_d6_pe9 &fmc_d7_pe10
		     &fmc_d8_pe11 &fmc_d9_pe12 &fmc_d10_pe13 &fmc_d11_pe14
		     &fmc_d12_pe15 &fmc_d13_pd8 &fmc_d14_pd9 &fmc_d15_pd10
		     &fmc_d16_ph8 &fmc_d17_ph9 &fmc_d18_ph10 &fmc_d19_ph11
		     &fmc_d20_ph12 &fmc_d21_ph13 &fmc_d22_ph14 &fmc_d23_ph15
		     &fmc_d24_pi0 &fmc_d25_pi1 &fmc_d26_pi2 &fmc_d27_pi3
		     &fmc_d28_pi6 &fmc_d29_pi7 &fmc_d30_pi9 &fmc_d31_pi10>;
	pinctrl-names = "default";
	status = "okay";

	sdram {
		status = "okay";
		power-up-delay = <100>;
		num-auto-refresh = <8>;
		mode-register = <0x230>;
		/* 64 ms / 4096 rows at 280 MHz / 3, minus controller margin. */
		refresh-rate = <1438>;

		bank@1 {
			reg = <1>;
			st,sdram-control = <STM32_FMC_SDRAM_NC_9 STM32_FMC_SDRAM_NR_12
					    STM32_FMC_SDRAM_MWID_32 STM32_FMC_SDRAM_NB_4
					    STM32_FMC_SDRAM_CAS_3 STM32_FMC_SDRAM_SDCLK_PERIOD_3
					    STM32_FMC_SDRAM_RBURST_ENABLE STM32_FMC_SDRAM_RPIPE_0>;
			st,sdram-timing = <2 7 4 7 2 2 2>;
		};
	};
};

#define LCD_PIN_HIGH_SPEED(pin) &pin { slew-rate = "high-speed"; };
LCD_PIN_HIGH_SPEED(ltdc_hsync_pi12)
LCD_PIN_HIGH_SPEED(ltdc_vsync_pi13)
LCD_PIN_HIGH_SPEED(ltdc_clk_pi14)
LCD_PIN_HIGH_SPEED(ltdc_r0_pi15)
LCD_PIN_HIGH_SPEED(ltdc_r1_pj0)
LCD_PIN_HIGH_SPEED(ltdc_r2_pj1)
LCD_PIN_HIGH_SPEED(ltdc_r3_pj2)
LCD_PIN_HIGH_SPEED(ltdc_r4_pj3)
LCD_PIN_HIGH_SPEED(ltdc_r5_pj4)
LCD_PIN_HIGH_SPEED(ltdc_r6_pj5)
LCD_PIN_HIGH_SPEED(ltdc_r7_pj6)
LCD_PIN_HIGH_SPEED(ltdc_g0_pj7)
LCD_PIN_HIGH_SPEED(ltdc_g1_pj8)
LCD_PIN_HIGH_SPEED(ltdc_g2_pj9)
LCD_PIN_HIGH_SPEED(ltdc_g3_pj10)
LCD_PIN_HIGH_SPEED(ltdc_g4_pj11)
LCD_PIN_HIGH_SPEED(ltdc_g5_pk0)
LCD_PIN_HIGH_SPEED(ltdc_g6_pk1)
LCD_PIN_HIGH_SPEED(ltdc_g7_pk2)
LCD_PIN_HIGH_SPEED(ltdc_b0_pj12)
LCD_PIN_HIGH_SPEED(ltdc_b1_pj13)
LCD_PIN_HIGH_SPEED(ltdc_b2_pj14)
LCD_PIN_HIGH_SPEED(ltdc_b3_pj15)
LCD_PIN_HIGH_SPEED(ltdc_b4_pk3)
LCD_PIN_HIGH_SPEED(ltdc_b5_pk4)
LCD_PIN_HIGH_SPEED(ltdc_b6_pk5)
LCD_PIN_HIGH_SPEED(ltdc_b7_pk6)
LCD_PIN_HIGH_SPEED(ltdc_de_pk7)
#undef LCD_PIN_HIGH_SPEED

&ltdc {
	pinctrl-0 = <&ltdc_hsync_pi12 &ltdc_vsync_pi13 &ltdc_clk_pi14 &ltdc_r0_pi15
		     &ltdc_r1_pj0 &ltdc_r2_pj1 &ltdc_r3_pj2 &ltdc_r4_pj3
		     &ltdc_r5_pj4 &ltdc_r6_pj5 &ltdc_r7_pj6 &ltdc_g0_pj7
		     &ltdc_g1_pj8 &ltdc_g2_pj9 &ltdc_g3_pj10 &ltdc_g4_pj11
		     &ltdc_g5_pk0 &ltdc_g6_pk1 &ltdc_g7_pk2 &ltdc_b0_pj12
		     &ltdc_b1_pj13 &ltdc_b2_pj14 &ltdc_b3_pj15 &ltdc_b4_pk3
		     &ltdc_b5_pk4 &ltdc_b6_pk5 &ltdc_b7_pk6 &ltdc_de_pk7>;
	pinctrl-names = "default";
	bl-ctrl-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
	/* The LTDC binding uses this property to select the framebuffer region. */
	ext-sdram = <&display_ram>;
	width = <800>;
	height = <480>;
	pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
	status = "okay";

	display-timings {
		compatible = "zephyr,panel-timing";
		hsync-active = <0>;
		vsync-active = <0>;
		de-active = <0>;
		pixelclk-active = <0>;
		hsync-len = <46>;
		vsync-len = <23>;
		hback-porch = <2>;
		hfront-porch = <210>;
		vback-porch = <2>;
		vfront-porch = <22>;
	};
};
